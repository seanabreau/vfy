    def from_records(
        has_arcs: bool,
        files: Sequence[FileInput],
        tracers: dict[str, str],
        metadata: dict[str, str],
        semantic: CoverageData | None = None,
    ) -> CoverageData: ...
    @staticmethod
    def read(path: str) -> CoverageData: ...
    @staticmethod
    def combine_transaction(
        paths: Sequence[str],
        output: str,
        base: CoverageData | None = None,
        keep: bool = False,
        strict: bool = False,
        include_output: bool = False,
        aliases: Sequence[list[str]] = ...,
        relative_files: bool = False,
    ) -> tuple[CoverageData | None, int]: ...
    @staticmethod
    def publish_transaction(
        incoming: CoverageData,
        paths: Sequence[str],
        output: str,
        include_output: bool = False,
        aliases: Sequence[list[str]] = ...,
        relative_files: bool = False,
    ) -> CoverageData: ...
    def copy(self, /) -> CoverageData: ...
    def merge(self, /, other: CoverageData) -> None: ...
    def merge_replace(self, /, other: CoverageData) -> None: ...
    def remap_paths(
        self, /, aliases: Sequence[list[str]], relative_files: bool = False
    ) -> CoverageData: ...
    def select_files(self, /, paths: Sequence[str]) -> CoverageData: ...
    def remap_paths_for_reporting(
        self, /, aliases: Sequence[list[str]], relative_files: bool = False
    ) -> CoverageData: ...
    def is_empty(self, /) -> bool: ...
    def has_tracers(self, /) -> bool: ...
    def lines_for(self, /, path: str) -> list[int] | None: ...
    def arcs_for(self, /, path: str) -> list[Arc] | None: ...
    def set_metadata(self, /, key: str, value: str) -> None: ...
    @staticmethod
    def replay_baseline(
        baseline: str,
        fresh: CoverageData,
        invalidated_tests: Sequence[str],
        changed_paths: Sequence[str],
        scoped_paths: Mapping[str, Sequence[tuple[int, int, int]]] = ...,
    ) -> CoverageData: ...
    def touch_file(self, /, path: str) -> None: ...
    def touch_files(self, /, paths: Sequence[str], tracer: str) -> None: ...
    def add_file_tracers(self, /, tracers: Sequence[tuple[str, str]]) -> None: ...
    def set_tracer(self, /, path: str, tracer: str) -> None: ...
    def add_lines(self, /, context: str, path: str, lines: Sequence[int]) -> None: ...
    def add_arcs(self, /, context: str, path: str, arcs: Sequence[Arc]) -> None: ...
    def write(self, /, path: str, metadata: dict[str, str] = ...) -> None: ...
    def measured_files(self, /) -> list[str]: ...
    def metadata_records(self, /) -> list[tuple[str, str]]: ...
    def tracer_records(self, /) -> list[tuple[str, str]]: ...
    def line_records(self, /) -> list[tuple[str, str, list[int]]]: ...
    def arc_records(self, /) -> list[tuple[str, str, list[Arc]]]: ...
    def has_semantic_data(self, /) -> bool: ...
    def semantic_records(self, /) -> list[tuple[str, str, int, int, str, str, str, str]]: ...
    def semantic_observation_records(self, /) -> list[tuple[str, str, str, bool]]: ...
    def semantic_path_records(
        self, /
    ) -> list[tuple[str, str, int, int, str, str, str, int, int]]: ...
    def semantic_path_outcome_records(
        self, /
    ) -> list[tuple[str, int, str, int, int, int, int]]: ...
    def semantic_path_observation_records(self, /) -> list[tuple[str, str, int]]: ...
    def semantic_condition_records(self, /) -> list[tuple[str, int, int, int, int, int]]: ...
